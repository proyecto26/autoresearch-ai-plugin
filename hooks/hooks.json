{
  "description": "Autoresearch AI plugin hooks — protect sensitive files during experiment loops",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-files.sh\""
          }
        ]
      }
    ]
  }
}
