# Normalize all text files to LF in the repo, native line endings on checkout
* text=auto

# Force LF for shell scripts (bash breaks on CRLF)
*.sh text eol=lf

# Force LF for markdown and JSON (consistency)
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf

# Force LF for JavaScript (eval runner scripts run on all OSes)
*.js text eol=lf

# Force LF for YAML (CI workflows)
*.yml text eol=lf
*.yaml text eol=lf

# Force LF for Python and config files
*.py text eol=lf
*.toml text eol=lf
